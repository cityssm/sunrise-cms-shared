{
  "name": "sunrise-cms-shared",
  "version": "0.0.11",
  "description": "Files shared between Sunrise CMS and Sunrise CMS Portal.",
  "keywords": [
    "sunrise-cms",
    "cemetery-management"
  ],
  "homepage": "https://github.com/cityssm/sunrise-cms-shared#readme",
  "bugs": {
    "url": "https://github.com/cityssm/sunrise-cms-shared/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityssm/sunrise-cms-shared.git"
  },
  "license": "MIT",
  "author": "The Corporation of the City of Sault Ste. Marie",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./api/api.endpoint.js": "./api/api.endpoint.js",
    "./api/doDataSync.endpoint.js": "./api/doDataSync.endpoint.js",
    "./api/doDeleteOrderForm.endpoint.js": "./api/doDeleteOrderForm.endpoint.js",
    "./api/doGetUnprocessedOrderForms.endpoint.js": "./api/doGetUnprocessedOrderForms.endpoint.js",
    "./api/doMarkOrderFormAsSynced.endpoint.js": "./api/doMarkOrderFormAsSynced.endpoint.js",
    "./types.js": "./types.js"
  },
  "main": "index.js",
  "files": [
    "api/*",
    "index.*",
    "types.*"
  ],
  "scripts": {
    "lint:cspell": "cspell lint \"**/*.{ts,md}\"",
    "lint:editorconfig": "editorconfig-checker",
    "lint:eslint:md": "eslint **/*.md",
    "lint:eslint:ts": "eslint --ignore-pattern \"**/*.d.ts\" --ignore-pattern \"test/**\" --no-warn-ignored \"**/*.ts\"",
    "lint:markdown": "markdownlint-cli2 --config .markdownlint.json \"**/*.md\" \"#node_modules\" \"#.github\""
  },
  "dependencies": {
    "@cityssm/utils-datetime": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "cspell-cli": "^10.3.0",
    "editorconfig-checker": "^7.0.0",
    "eslint-config-cityssm": "^57.1.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier-config-cityssm": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
